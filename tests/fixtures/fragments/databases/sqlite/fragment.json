{
  "schemaVersion": 1,
  "id": "database-sqlite",
  "kind": "database",
  "requires": ["base"],
  "capabilities": ["database"],
  "files": ["config/database.ts", "plugins/store/connect.ts"],
  "package": {
    "dependencies": {
      "@stackpress/inquire-sqlite3": "0.10.8",
      "better-sqlite3": "12.4.1"
    },
    "plugins": ["./plugins/store/plugin"]
  },
  "env": ["DATABASE_URL=./.build/database.sqlite"]
}
