{
  "schemaVersion": 1,
  "id": "database-postgres",
  "kind": "database",
  "requires": ["base"],
  "capabilities": ["database"],
  "files": ["config/database.ts", "plugins/store/connect.ts"],
  "package": {
    "dependencies": {
      "@stackpress/inquire-pg": "0.10.8",
      "pg": "8.16.3"
    },
    "plugins": ["./plugins/store/plugin"]
  },
  "env": ["DATABASE_URL=postgres://postgres:postgres@localhost:5432/stackpress"]
}
