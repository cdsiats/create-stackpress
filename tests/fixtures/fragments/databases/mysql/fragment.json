{
  "schemaVersion": 1,
  "id": "database-mysql",
  "kind": "database",
  "requires": ["base"],
  "capabilities": ["database"],
  "files": ["config/database.ts", "plugins/store/connect.ts"],
  "package": {
    "dependencies": {
      "@stackpress/inquire-mysql2": "0.10.8",
      "mysql2": "3.15.3"
    },
    "plugins": ["./plugins/store/plugin"]
  },
  "env": ["DATABASE_URL=mysql://root:root@localhost:3306/stackpress"]
}
