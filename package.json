{
  "name": "@cdsiats/create-stackpress",
  "version": "0.1.0",
  "private": false,
  "description": "Scaffold Stackpress applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdsiats/create-stackpress.git"
  },
  "homepage": "https://github.com/cdsiats/create-stackpress#readme",
  "bugs": {
    "url": "https://github.com/cdsiats/create-stackpress/issues"
  },
  "keywords": [
    "stackpress",
    "scaffold",
    "generator",
    "cli",
    "typescript",
    "react",
    "pglite",
    "postgresql",
    "cockroachdb",
    "mysql",
    "sqlite"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "create-stackpress": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:snapshot": "node scripts/test.mjs snapshot",
    "test:integration": "node scripts/test.mjs integration",
    "test:smoke": "node scripts/test.mjs smoke",
    "test:watch": "node --import tsx --test --watch tests"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "25.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
