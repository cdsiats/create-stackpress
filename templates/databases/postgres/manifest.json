{
  "schemaVersion": 1,
  "id": "database-postgres",
  "kind": "database",
  "requires": [
    "base"
  ],
  "capabilities": [
    "database"
  ],
  "files": [
    "plugins/store/connect.ts"
  ],
  "assets": [],
  "package": {
    "dependencies": {
      "@stackpress/inquire-pg": "0.10.8",
      "pg": "8.16.3"
    },
    "devDependencies": {
      "@types/pg": "8.16.0"
    },
    "scripts": {},
    "plugins": [
      "plugins/store/plugin"
    ]
  },
  "env": [
    "DATABASE_URL=postgres://postgres:postgres@localhost:5432/app"
  ]
}
